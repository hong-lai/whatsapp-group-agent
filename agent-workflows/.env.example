DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5433/whatsapp
REDIS_URL=redis://localhost:6380
MESSAGE_EVENTS_QUEUE=message-events

# Comma-separated. Empty disables all workflows without stopping the worker.
ENABLED_WORKFLOWS=daily_site_report

# LM Studio OpenAI-compatible API (host only — not containerized)
# From docker compose, the default is http://host.docker.internal:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=1234
LLM_MODEL=google/gemma-4-e2b
LLM_TEMPERATURE=0
LLM_ENABLE_THINKING=true

DAILY_SITE_REPORT_PROMPTS_DIR=./private/daily_site_report
CONCURRENCY=1
