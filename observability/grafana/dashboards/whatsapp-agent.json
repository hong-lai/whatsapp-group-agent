{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "WhatsApp connected",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "Down" }, "1": { "color": "green", "text": "Up" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "whatsapp_connection_up{service_name=\"whatsapp-group-agent\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Messages / min",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(whatsapp_messages_ingested_total{service_name=\"whatsapp-group-agent\"}[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Catchup pending",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "whatsapp_catchup_pending{service_name=\"whatsapp-group-agent\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RSS memory",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "process_memory_rss_bytes{service_name=\"whatsapp-group-agent\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CPU (cores)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "process_cpu_utilization_ratio{service_name=\"whatsapp-group-agent\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disconnects (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(increase(whatsapp_disconnects_total{service_name=\"whatsapp-group-agent\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages ingested",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (whatsapp_message_result, whatsapp_message_type) (rate(whatsapp_messages_ingested_total{service_name=\"whatsapp-group-agent\"}[5m]))",
          "legendFormat": "{{whatsapp_message_result}} {{whatsapp_message_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Media downloads",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (whatsapp_media_result) (rate(whatsapp_media_downloads_total{service_name=\"whatsapp-group-agent\"}[5m]))",
          "legendFormat": "{{whatsapp_media_result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Media download duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(whatsapp_media_download_duration_milliseconds_bucket{service_name=\"whatsapp-group-agent\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(whatsapp_media_download_duration_milliseconds_bucket{service_name=\"whatsapp-group-agent\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "History sync duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(whatsapp_history_sync_duration_milliseconds_bucket{service_name=\"whatsapp-group-agent\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU and memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "RSS" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Heap" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "CPU" }, "properties": [{ "id": "unit", "value": "percentunit" }] }
        ]
      },
      "targets": [
        {
          "expr": "process_memory_rss_bytes{service_name=\"whatsapp-group-agent\"}",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "process_memory_heap_used_bytes{service_name=\"whatsapp-group-agent\"}",
          "legendFormat": "Heap",
          "refId": "B"
        },
        {
          "expr": "process_cpu_utilization_ratio{service_name=\"whatsapp-group-agent\"}",
          "legendFormat": "CPU",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dashboard HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (http_route, http_status_code) (rate(http_server_requests_total{service_name=\"whatsapp-group-agent\"}[5m]))",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["whatsapp", "otel"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "WhatsApp Group Agent",
  "uid": "whatsapp-group-agent",
  "version": 1
}
